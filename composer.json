{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bvp/converter",
    "description": "Converter for Boatrace Venture Project",
    "keywords": [
        "boatrace",
        "converter",
        "library"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "bvp@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/shimomo/bvp-converter/issues",
        "source": "https://github.com/shimomo/bvp-converter"
    },
    "require": {
        "php": "^8.2",
        "bvp/prefecture": "^0.1",
        "bvp/stadium": "^0.1",
        "bvp/trimmer": "^0.1",
        "shimomo/helper": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1 || ^11.1 || ^12.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "BVP\\Converter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\Converter\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
