{
    "name": "bvp/converter",
    "description": "The BVP Converter package for Boatrace.",
    "keywords": [
        "boatrace",
        "converter",
        "library"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "bvp@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/shimomo/bvp-converter/issues",
        "source": "https://github.com/shimomo/bvp-converter"
    },
    "require": {
        "php": "^8.2",
        "bvp/prefecture": "^5.x-dev",
        "bvp/stadium": "^5.x-dev",
        "bvp/trimmer": "^5.x-dev",
        "shimomo/helper": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1 || ^11.1 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "BVP\\Converter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\Converter\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
