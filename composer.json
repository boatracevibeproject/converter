{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bvp/converter",
    "description": "BVP Converter：場・級別・天候・風向・決まり手などのコードと名称を変換する PHP ライブラリ | PHP library for converting boatrace codes and names",
    "keywords": [
        "boatrace",
        "converter",
        "library"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "bvp@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/boatracevibeproject/converter/issues",
        "source": "https://github.com/boatracevibeproject/converter"
    },
    "require": {
        "php": "^8.2",
        "bvp/prefecture": "^6.0",
        "bvp/stadium": "^6.0",
        "bvp/trimmer": "^6.0",
        "shimomo/helper": "^0.1"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^10.1 || ^11.1 || ^12.0",
        "squizlabs/php_codesniffer": "^3.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "BVP\\Converter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\Converter\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "lint:fix": [
            "@php vendor/bin/pint"
        ]
    }
}
